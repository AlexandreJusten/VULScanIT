{
  "name": "vulscanit",
  "version": "1.0.0",
  "private": true,
  "description": "VULScanIT — Developer Security Intelligence Platform — dependency scanner, CVE lookup, CISA KEV monitoring, and security utilities.",
  "keywords": [
    "devsecops",
    "vulnerability-scanner",
    "cve",
    "osv",
    "security",
    "react",
    "express",
    "cisa-kev",
    "vulscanit"
  ],
  "author": "VULScanIT Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/seu-usuario/vulscanit.git"
  },
  "bugs": {
    "url": "https://github.com/seu-usuario/vulscanit/issues"
  },
  "homepage": "https://github.com/seu-usuario/vulscanit#readme",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite --host 0.0.0.0",
    "build": "vite build",
    "start": "cross-env NODE_ENV=production node server/index.js"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "lucide-react": "^0.468.0",
    "multer": "^2.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "vite": "^6.0.5"
  }
}
